# Pitaka Sales — copy to .env and fill in. Real values never go into git.
# Only BITRIX_WEBHOOK_URL is needed to start; GEMINI_API_KEY enables call analysis.

# REQUIRED — Bitrix24 inbound webhook (rights: crm, disk, user). Used read-only:
# write methods are refused unless BITRIX_ALLOW_WRITES=1 is set on purpose.
BITRIX_WEBHOOK_URL=https://crm.example.uz/rest/1/WEBHOOK_TOKEN/
# Portal base URL, used for links from the panel to CRM records
BITRIX_PORTAL=https://crm.example.uz

# Gemini key — call transcription and scoring
GEMINI_API_KEY=
STT_ENGINE=gemini

# Web server (defaults: 127.0.0.1:8090, DB in data/sotuv.db)
PORT=8090
HOST=127.0.0.1

# Built-in call agent (defaults: every 5 min, up to 6 calls, last 1 day). AGENT_AUTO=0 turns it off.
AGENT_AUTO=1
AGENT_INTERVAL_MIN=5
AGENT_LIMIT=6
AGENT_DAYS=1

# ffmpeg / ffprobe must be on PATH, or set full paths here
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe

# Optional — Murabbiy Telegram bot for operators
MURABBIY_BOT_TOKEN=
